<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ================= -->
    <!-- 🔝 상단바 영역     -->
    <!-- ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 뒤로가기 아이콘 -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- 제목 -->
        <TextView
            android:id="@+id/titleFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="피드백"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/scoreBox"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- 정보 아이콘 -->
        <ImageView
            android:id="@+id/btnInfo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- 점수 박스 -->
        <TextView
            android:id="@+id/scoreBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.3/10"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/rounded_red_button_bg"
            app:layout_constraintTop_toBottomOf="@id/titleFeedback"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ======================= -->
    <!--   🔽 하단 피드백 박스 영역    -->
    <!-- ======================= -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:gravity="center"
        android:background="#00FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 회색 피드백 박스 -->
        <View
            android:id="@+id/feedbackBox"
            android:layout_width="260dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_feedback_box"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
