<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 전체 화면 사진 -->
    <ImageView
        android:id="@+id/imageFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <!-- 상단 오버레이 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <!-- 상단바 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- 뒤로가기 버튼 -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                app:tint="#FFFFFF"/>

            <!-- (i) 정보 버튼 -->
            <ImageView
                android:id="@+id/btnInfo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:src="@drawable/info"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                app:tint="#FFFFFF"/>

        </RelativeLayout>

        <!-- 점수 표시 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- 피드백 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="피드백"
                android:textSize="23sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <!-- 점수 박스 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_score_badge"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.3"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 10"
                    android:textSize="16sp"
                    android:textColor="#CCFFFFFF"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/feedbackMessageBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="80dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_feedback_message"
        android:padding="20dp"
        android:elevation="8dp">

        <!-- 상단 제목: "세부 평가" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="세부 평가"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <!-- 1. 구도 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="구도 (Composition)"
                android:textColor="#000000"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressComposition"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="120dp"
                android:layout_height="8dp"
                android:progress="80"
                android:max="100"
                android:progressDrawable="@drawable/progress_green" />
        </LinearLayout>

        <!-- 2. 조명 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="조명 (Lighting)"
                android:textColor="#000000"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressLighting"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="120dp"
                android:layout_height="8dp"
                android:progress="60"
                android:max="100"
                android:progressDrawable="@drawable/progress_blue" />
        </LinearLayout>

        <!-- 3. 초점 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="초점 (Focus)"
                android:textColor="#000000"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressFocus"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="120dp"
                android:layout_height="8dp"
                android:progress="40"
                android:max="100"
                android:progressDrawable="@drawable/progress_orange" />
        </LinearLayout>

    </LinearLayout>


</FrameLayout>