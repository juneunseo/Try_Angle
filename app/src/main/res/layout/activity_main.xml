<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ▼ 프리뷰 컨테이너 -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true">

        <TextureView
            android:id="@+id/textureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.camera2app.ui.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/timerCountdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="120sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:visibility="gone"
            android:elevation="100dp" />

        <View
            android:id="@+id/blurOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ▼ 상단 바 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="8dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ▼ FPS 라벨 -->
    <TextView
        android:id="@+id/fpsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="64dp"
        android:padding="6dp"
        android:text="0.0 FPS"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:background="#66000000"
        android:elevation="8dp" />

    <!-- ▼ 옵션 버튼 (하단 바 위 오른쪽) -->
    <ImageView
        android:id="@+id/btnOptions"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:src="@drawable/options"
        android:padding="6dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="180dp"
        android:elevation="30dp" />

    <!-- ★ 옵션바 - 독립적으로 떠있음 -->
    <LinearLayout
        android:id="@+id/optionBar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="180dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:background="@drawable/pill_black_translucent_bg"
        android:elevation="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnExp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXP"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnTimer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/btn_timer"
            android:layout_marginStart="24dp" />

        <TextView
            android:id="@+id/btnRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:9"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginStart="24dp" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_flash_off"
            app:tint="#FFFFFF"
            android:layout_marginStart="24dp" />

        <ImageButton
            android:id="@+id/btnCloseOption"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            app:srcCompat="@drawable/ic_close"
            android:layout_marginStart="24dp" />

    </LinearLayout>

    <!-- ▼ UI 박스 (하단바 + 메뉴) -->
    <LinearLayout
        android:id="@+id/uiContainer"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:elevation="16dp">

        <!-- ▼ 하단 바 -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#CC000000"
            android:paddingHorizontal="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnShutter"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@android:color/transparent"
                app:srcCompat="@drawable/ic_shutter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnSwitch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/ic_switch_camera" />
            </LinearLayout>
        </LinearLayout>

        <!-- ▼ 하단 메뉴 -->
        <LinearLayout
            android:id="@+id/bottomMenu"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="#CC000000"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/menuGallery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="갤러리"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/menuCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="카메라"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/menuReference"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="레퍼런스"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ▼ 촬영 플래시 -->
    <View
        android:id="@+id/shutterFlashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:alpha="0"
        android:clickable="false" />

</FrameLayout>